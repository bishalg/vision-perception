# owner: WP-B.18 (DPL-1)
# Clinic server settings. install.sh writes the real .env (mode 0600) with random secrets;
# you should not need to create it by hand. This file documents each value and is what
# `docker compose --env-file .env.example config` (CI lint) runs against. Placeholders only.

# ---- release
# Image tag of asd-backend / asd-console / asd-backup. Changed only by upgrade.sh.
ASD_VERSION=0.1.0
# Registry prefix for the images, e.g. ghcr.io/example/ (with the trailing slash). Empty =
# images built on this server from the source checkout.
ASD_IMAGE_PREFIX=

# ---- address and TLS (DPL-3)
# DNS name of the console; the device API is api.<DOMAIN>. Never an IP address (iOS).
DOMAIN=clinic.example.org
# letsencrypt | internal | tunnel  (README.md "TLS modes")
TLS_MODE=internal
# "http://" in tunnel mode (Cloudflare terminates TLS), empty otherwise.
SITE_SCHEME=
# Let's Encrypt account e-mail and the owner sign-in.
ADMIN_EMAIL=it@example.org
# Host address Caddy publishes on: 0.0.0.0, or 127.0.0.1 in tunnel mode (only cloudflared
# may reach Caddy there).
PUBLISH_ADDR=0.0.0.0
# Host ports Caddy publishes (the only published ports). 80/443 for letsencrypt.
HTTP_PORT=80
HTTPS_PORT=443
# tunnel mode only: the token of a Cloudflare Tunnel whose public hostnames <DOMAIN> and
# api.<DOMAIN> point at http://caddy:80.
CLOUDFLARE_TUNNEL_TOKEN=

# ---- state on the host
# Backups (backups/), drill results (drills/), Caddy's root certificate (internal mode).
ASD_STATE_DIR=/var/lib/asd

# ---- database (Postgres 16, compose network only)
# Owner role `asd` (migrate, backup, admin commands).
POSTGRES_PASSWORD=change-me-owner
# `asd_app` (api, worker): DML only, append-only audit_log (threat-model F10).
ASD_APP_DB_PASSWORD=change-me-app

# ---- blob store (MinIO, compose network only)
MINIO_ROOT_USER=rootchangeme
MINIO_ROOT_PASSWORD=change-me-minio-root
# The API's own MinIO user (readwrite), created by minio-init.
MINIO_APP_ACCESS_KEY=appchangeme
MINIO_APP_SECRET_KEY=change-me-minio-app

# ---- keys (rust/.env.example has the details)
# Clinical-data key-encryption key: base64 of 32 random bytes. On the KEY CARD. Losing it
# loses all clinical text; it is never in a backup.
ASD_DATA_KEK=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
# Ed25519 seeds (base64, 32 bytes) from `asd-cli bundle keygen`; must differ.
ASD_JWT_SIGNING_KEY=AQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQE=
ASD_BUNDLE_SIGNING_KEY=AgICAgICAgICAgICAgICAgICAgICAgICAgICAgICAgI=
# Its public key (for the iPad app's configuration). Not secret.
ASD_BUNDLE_PUBLIC_KEY=placeholder

# ---- backups (DPL-6..8)
# age public key; the private half is only on the key card.
BACKUP_AGE_RECIPIENT=age1placeholderplaceholderplaceholderplaceholderplaceholderpl
# Where restore-drill.sh finds the private backup key (optional; README "Restore drill").
BACKUP_KEY_FILE=/etc/asd/backup-key.txt
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8
# Optional off-site copy of the encrypted archives: an rclone remote such as
# "offsite:clinic-backups", configured in <ASD_STATE_DIR>/rclone.conf.
BACKUP_REMOTE=
