# Copy to .env.local. Never commit real values.

# "mock" runs entirely on in-repo synthetic fixtures (no backend needed).
# "live" talks to the ASD backend at CURV_API_BASE_URL.
CURV_API_MODE=mock

# Backend origin (no trailing slash, no /v1). Server-side only; never exposed to the browser.
CURV_API_BASE_URL=http://localhost:8000

# Set to "true" when served over https (always in production) so cookies are Secure.
CURV_COOKIE_SECURE=false
