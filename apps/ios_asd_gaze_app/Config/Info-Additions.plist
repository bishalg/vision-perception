<plist version="1.0">
<dict>
	<!-- SIM-7: no UIRequiredDeviceCapabilities on purpose. `arkit` blocks Apple Vision Pro (visionOS does
	     not offer it) and `front-facing-camera` filters no iOS 18 device but is not honoured on visionOS
	     builds. Face tracking is gated at runtime instead (CaptureEntryGate, GazeSessionController.startSession).
	     Capabilities cannot be added back after release: that would tighten the requirement. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
