    "calibrate_result_poor_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The gaze points were spread out. Check the lighting and distance and keep the phone still, then try again, or continue with this calibration."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "नज़र के बिंदु बिखरे हुए थे। रोशनी और दूरी जाँचें और फ़ोन स्थिर रखें, फिर दोबारा कोशिश करें, या इसी कैलिब्रेशन के साथ आगे बढ़ें।"
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "दृष्टि बिन्दुहरू छरिएका थिए। उज्यालो र दूरी जाँच गर्नुहोस् र फोन स्थिर राख्नुहोस्, अनि फेरि प्रयास गर्नुहोस्, वा यही क्यालिब्रेसनसँग अगाडि बढ्नुहोस्।"
          }
        }
      }
    },
