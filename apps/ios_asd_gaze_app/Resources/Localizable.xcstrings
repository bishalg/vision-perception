    "dashboard_clinical_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Measures where your child looks during short clips. This is not a diagnostic tool. Please talk with your pediatrician about any concerns."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "छोटे क्लिप के दौरान आपका बच्चा कहाँ देखता है, यह मापता है। यह निदान करने का उपकरण नहीं है। कोई चिंता हो तो बाल रोग विशेषज्ञ से बात करें।"
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "छोटा क्लिपहरूमा तपाईंको बच्चाले कहाँ हेर्छ भन्ने मापन गर्दछ। यो निदान गर्ने उपकरण होइन। कुनै चिन्ता भए बाल रोग विशेषज्ञसँग कुरा गर्नुहोस्।"
          }
        }
      }
    },
