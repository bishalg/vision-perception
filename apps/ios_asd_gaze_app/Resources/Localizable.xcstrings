{
  "sourceLanguage" : "en",
  "strings" : {
    "about_records_gaze" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It records where a child looks during short clips."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "यह छोटे क्लिप के दौरान बच्चा कहाँ देखता है, इसे रिकॉर्ड करता है।"
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "यसले छोटा क्लिपहरूमा बच्चाले कहाँ हेर्छ भनेर रेकर्ड गर्छ।"
          }
        }
      }
    },
    "about_translation_under_review" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Translation under review"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "अनुवाद की समीक्षा जारी है"
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "अनुवादको समीक्षा हुँदैछ"
          }
        }
      }
    },
    "calibrate_continue_anyway" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continue anyway"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "फिर भी आगे बढ़ें"
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "जे भए पनि अगाडि बढ्नुहोस्"
          }
        }
      }
    },
    "calibrate_failed_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We could not see your child's eyes for one of the balloons. Check the lighting and distance, then try again."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "एक गुब्बारे के लिए हम आपके बच्चे की आँखें नहीं देख सके। रोशनी और दूरी जाँचें, फिर दोबारा कोशिश करें।"
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "एउटा बेलुनको लागि हामीले तपाईंको बच्चाको आँखा देख्न सकेनौं। उज्यालो र दूरी जाँच गर्नुहोस्, अनि फेरि प्रयास गर्नुहोस्।"
          }
        }
      }
    },
    "calibrate_failed_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calibration did not finish"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "कैलिब्रेशन पूरा नहीं हुआ"
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "क्यालिब्रेसन पूरा भएन"
          }
        }
      }
    },
    "calibrate_instruction" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold device 40-50 cm away. Look at the balloon to pop it."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "उपकरण 40-50 सेमी दूर रखें। गुब्बारा देखकर फोड़ें।"
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "उपकरण ४०-५० सेमि टाढा राख्नुहोस्। बेलुन हेरेर फुटाउनुहोस्।"
          }
        }
      }
    },
    "calibrate_limit_reached" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No more calibration attempts are available in this session."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "इस सत्र में और कैलिब्रेशन प्रयास उपलब्ध नहीं हैं।"
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "यो सत्रमा थप क्यालिब्रेसन प्रयास उपलब्ध छैन।"
          }
        }
      }
    },
    "calibrate_result_great" : {
