        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "इस सप्ताह रिकॉर्ड किए गए सत्र इस डिवाइस पर सहेजे गए हैं और आपके क्लिनिक की समीक्षा के लिए तैयार हैं।"
