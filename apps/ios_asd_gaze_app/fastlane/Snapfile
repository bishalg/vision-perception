# Fastlane Snapfile for the EarlyGaze iOS app
# Reference: https://docs.fastlane.tools/actions/snapshot/

devices([
  "iPhone 16 Pro Max",
  "iPhone 16 Pro",
  "iPhone 15",
  "iPad Pro 13-inch (M4)"
])

languages([
  "en-US",
  "hi",
  "ne-NP"
])

scheme("AsdGazeCollector")
output_directory("./fastlane/screenshots")
clear_previous_screenshots(true)
reinstall_app(true)

