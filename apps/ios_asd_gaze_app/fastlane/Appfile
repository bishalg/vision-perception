# Appfile for EarlyGaze (ASD Gaze Collector) iOS App
# Identity comes from the environment; nothing personal is committed (CI-4).
#   APP_IDENTIFIER  bundle id (default until decision H4)
#   APPLE_ID        Apple ID used by fastlane
#   APPLE_TEAM_ID   Developer Portal team id
#   ITC_TEAM_ID     App Store Connect team id (optional)

app_identifier(ENV["APP_IDENTIFIER"] || "org.curv.asd.gazecollector")
apple_id(ENV["APPLE_ID"]) if ENV["APPLE_ID"] && !ENV["APPLE_ID"].empty?
team_id(ENV["APPLE_TEAM_ID"]) if ENV["APPLE_TEAM_ID"] && !ENV["APPLE_TEAM_ID"].empty?
itc_team_id(ENV["ITC_TEAM_ID"]) if ENV["ITC_TEAM_ID"] && !ENV["ITC_TEAM_ID"].empty?

# For more information about the Appfile, see:
# https://docs.fastlane.tools/advanced/Appfile/
