# Fastlane Matchfile for ASD Gaze Collector iOS App
# Reference: https://docs.fastlane.tools/actions/match/

git_url(ENV["MATCH_GIT_URL"] || "git@github.com:curv/fastlane-certs.git")
git_branch(ENV["MATCH_GIT_BRANCH"] || "main")
storage_mode(ENV["MATCH_STORAGE_MODE"] || "git") # 'git', 'google_cloud', or 's3'

type("appstore") # The default type, can be: appstore, adhoc, enterprise, development

app_identifier([
  "org.curv.asd.gazecollector",
  "org.curv.asd.gazecollector.carewidget"
])
team_id(ENV.fetch("APPLE_TEAM_ID", "6J3WY94J6T"))

# Set to true in CI to never modify the certs repo
readonly(ENV.fetch("MATCH_READONLY", "false") == "true")
clone_branch_directly(false)