      "stim_01_social_peekaboo_8s": {
        "title": "Direct Social Eye Contact",
        "category": "Social Engagement",
        "weight": 0.2,
        "segments": [
          {
            "id": "peekaboo_direct_gaze",
            "description": "Actor plays peek-a-boo with direct eye contact toward the camera.",
            "startSec": 0.0,
            "endSec": 8.0,
            "expectations": [
              {
                "biomarker": "eye_dwell_ratio",
                "direction": "band",
                "byAge": {
                  "default": {
                    "expected": 0.35,
                    "acceptableLow": 0.25,
                    "acceptableHigh": 0.45
                  }
                },
                "citation": "Eye-region share of face dwell; typical 0.25-0.45 (Curv clinical baseline; JBI 2022 feature set).",
                "source": "literature"
              },
              {
                "biomarker": "first_entry_latency_ms",
                "direction": "lowerBetter",
                "targetAOI": "Eye_Region",
                "byAge": {
                  "12-17": {
                    "expected": 500.0,
                    "acceptableHigh": 750.0
                  },
                  "default": {
                    "expected": 420.0,
                    "acceptableHigh": 600.0
                  }
                },
                "citation": "Typical first-eye latency <420ms, prolonged >600ms (Curv clinical baseline; Jones et al. JAMA 2023 time-to-first-fixation). Younger bracket interpolated.",
                "source": "literature"
              },
              {
                "biomarker": "smile_reactivity_index",
                "direction": "higherBetter",
                "byAge": {
                  "default": {
                    "expected": 0.2,
                    "acceptableLow": 0.1
                  }
                },
                "citation": "Smile reactivity <0.20 attenuated, >=0.30 strong (Curv clinical baseline; Perochon et al. NEJM AI 2024 smile-frequency biomarkers).",
                "source": "literature"
              }
            ]
          }
        ]
      },
