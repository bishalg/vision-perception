            "endSec": 8.0,
            "expectations": [
              {
                "biomarker": "social_dwell_ratio",
                "direction": "higherBetter",
                "byAge": {
                  "default": {
                    "expected": 0.7,
                    "acceptableLow": 0.55
                  }
                },
                "citation": "Neurotypical toddlers spend >70% of viewing time on the social side (Pierce et al., eLife 2019; Pierce 2011/2016).",
                "source": "literature"
              },
              {
                "biomarker": "geometric_dwell_ratio",
                "direction": "lowerBetter",
                "byAge": {
                  "default": {
                    "expected": 0.3,
                    "acceptableHigh": 0.6
                  }
                },
                "citation": "Geometric fixation >=69% marks the ASD-Geo subtype at 98-99% specificity (Pierce et al., eLife 2019); this band flags above 60% so the 69% rule sits inside the atypical zone.",
                "source": "literature"
              },
              {
                "biomarker": "social_preference_score",
                "direction": "higherBetter",
                "byAge": {
                  "default": {
                    "expected": 0.4,
                    "acceptableLow": 0.1
                  }
                },
                "citation": "Derived from the >70% social-dwell anchor: (0.70-0.30)/(0.70+0.30) = 0.40 expected preference index; margins interpolated.",
