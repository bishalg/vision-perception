{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Curv Console",
  "version": "0.1.0",
  "identifier": "com.open-spectrum.curv.desktop",
  "build": {
    "frontendDist": "setup"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src ipc: http://ipc.localhost; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'",
      "freezePrototype": true,
      "capabilities": ["setup"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "MedicalSoftware",
    "shortDescription": "Curv Console desktop shell",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
