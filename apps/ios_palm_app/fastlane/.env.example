# App Identifier & Team
APP_IDENTIFIER="org.curv.palmapp"
APPLE_ID="your-apple-id@email.com"
APPLE_TEAM_ID="6J3WY94J6T"
ITC_TEAM_ID=""

# App Store Connect API Key (Recommended for CI/CD & no 2FA prompts)
APP_STORE_CONNECT_API_KEY_KEY_ID="XXXXXXXXXX"
APP_STORE_CONNECT_API_KEY_ISSUER_ID="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
APP_STORE_CONNECT_API_KEY_KEY_FILEPATH="./fastlane/AuthKey_XXXXXXXXXX.p8"
# Or provide key content directly as base64 string:
# APP_STORE_CONNECT_API_KEY_KEY_CONTENT="LS0t..."
# APP_STORE_CONNECT_API_KEY_IS_KEY_CONTENT_BASE64="true"

# Fastlane Match (Encrypted Git/S3 repository for team certificates)
MATCH_GIT_URL="git@github.com:your-org/ios-certificates.git"
MATCH_STORAGE_MODE="git"
MATCH_PASSWORD="your-secure-match-passphrase"
