# Fastfile for PalmReader iOS App
# Production App Store Connect & TestFlight automation pipeline
# 
# Import shared lanes from monorepo tooling
import "../../../fastlane/tooling/Fastfile.shared"

require 'yaml'
require 'fileutils'

CONFIG = YAML.load_file('fastlane/config.yml') rescue {}

platform :ios do
  before_all do
    Dotenv.load if defined?(Dotenv)

    # Configure App Store Connect API Key
    if ENV["ASC_KEY_ID"] && ENV["ASC_ISSUER_ID"] && ENV["ASC_API_KEY_PATH"]
      app_store_connect_api_key(
        key_id: ENV["ASC_KEY_ID"],
        issuer_id: ENV["ASC_ISSUER_ID"],
        key_filepath: ENV["ASC_API_KEY_PATH"],
        is_key_content_base64: false
      )
    elsif ENV["ASC_KEY_ID"] && ENV["ASC_ISSUER_ID"] && ENV["ASC_KEY_CONTENT"]
      app_store_connect_api_key(
        key_id: ENV["ASC_KEY_ID"],
        issuer_id: ENV["ASC_ISSUER_ID"],
        key_content: ENV["ASC_KEY_CONTENT"],
        is_key_content_base64: ENV["ASC_IS_KEY_CONTENT_BASE64"] == "true"
      )
    end
  end

  # =========================================================================
  # 0. VALIDATION & PRE-SUBMISSION CHECKS
  # =========================================================================

  desc "Run local pre-submission validation on files and structure"
  lane :validate_app_local do
    UI.message("🔍 Validating PalmReader local App Store assets...")

    app_root = File.expand_path("..", __dir__)
    Dir.chdir(app_root) do
      # 1. Check metadata directory
      metadata_path = "fastlane/metadata"
      if Dir.exist?(metadata_path)
        meta_files = Dir.glob("#{metadata_path}/**/*").select { |f| File.file?(f) }
        UI.success("✅ Metadata directory exists with #{meta_files.count} files")
      else
        UI.user_error!("❌ Metadata directory missing at #{metadata_path}")
      end

      # 2. Check screenshots directory
      screenshots_path = "fastlane/screenshots"
      if Dir.exist?(screenshots_path)
        sc_files = Dir.glob("#{screenshots_path}/**/*").select { |f| File.file?(f) }
        UI.success("✅ Screenshots directory exists with #{sc_files.count} files")
      else
        UI.user_error!("❌ Screenshots directory missing at #{screenshots_path}")
      end

      # 3. Check App Identifier
      app_id = CONFIG["app_identifier"] || "org.curv.palmapp"
      if app_id.match?(/^([a-zA-Z0-9_]+\.)*[a-zA-Z0-9_]+$/)
        UI.success("✅ App Identifier is valid: #{app_id}")
      else
        UI.user_error!("❌ Invalid App Identifier: #{app_id}")
      end

      # 4. Check required metadata files
      required_files = [
        "fastlane/metadata/en-US/name.txt",
        "fastlane/metadata/en-US/subtitle.txt",
        "fastlane/metadata/en-US/description.txt",
        "fastlane/metadata/en-US/keywords.txt",
        "fastlane/metadata/en-US/privacy_url.txt",
        "fastlane/metadata/en-US/support_url.txt"
      ]

      missing = required_files.select { |f| !File.exist?(f) }
      if missing.empty?
        UI.success("✅ All essential metadata files exist")
      else
        UI.user_error!("❌ Missing required metadata files: #{missing.join(', ')}")
      end
    end
  end

  desc "Validate App Store metadata string lengths and character constraints"
  lane :validate_metadata do
    validate_app_local

    UI.message("📏 Checking App Store metadata limits (Apple ASO constraints)...")
    base = "metadata"

    %w[en-US hi ne-NP].each do |locale|
      loc_dir = File.join(base, locale)
      next unless Dir.exist?(loc_dir)

      # Name: max 30 chars
      name_file = File.join(loc_dir, "name.txt")
      if File.exist?(name_file)
        val = File.read(name_file).strip
        UI.user_error!("Name in #{locale} exceeds 30 chars: #{val.length} ('#{val}')") if val.length > 30
        UI.success("  [#{locale}] Name: #{val.length}/30 ('#{val}')")
      end

      # Subtitle: max 30 chars
      sub_file = File.join(loc_dir, "subtitle.txt")
      if File.exist?(sub_file)
        val = File.read(sub_file).strip
        UI.user_error!("Subtitle in #{locale} exceeds 30 chars: #{val.length} ('#{val}')") if val.length > 30
        UI.success("  [#{locale}] Subtitle: #{val.length}/30 ('#{val}')")
      end

      # Keywords: max 100 chars
      kw_file = File.join(loc_dir, "keywords.txt")
      if File.exist?(kw_file)
        val = File.read(kw_file).strip
        UI.user_error!("Keywords in #{locale} exceeds 100 chars: #{val.length}") if val.length > 100
        UI.success("  [#{locale}] Keywords: #{val.length}/100")
      end

      # Promotional Text: max 170 chars
      promo_file = File.join(loc_dir, "promotional_text.txt")
      if File.exist?(promo_file)
        val = File.read(promo_file).strip
        UI.user_error!("Promotional text in #{locale} exceeds 170 chars: #{val.length}") if val.length > 170
        UI.success("  [#{locale}] Promo text: #{val.length}/170")
      end

      # Description: max 4000 chars
      desc_file = File.join(loc_dir, "description.txt")
      if File.exist?(desc_file)
        val = File.read(desc_file).strip
        UI.user_error!("Description in #{locale} exceeds 4000 chars: #{val.length}") if val.length > 4000
        UI.success("  [#{locale}] Description length: #{val.length}/4000")
      end
    end

    UI.success("🎯 All metadata constraints satisfied successfully!")
  end

  desc "Run App Store precheck rules on metadata"
  lane :appstore_precheck do
    precheck(
      app_identifier: CONFIG["app_identifier"] || "org.curv.palmapp",
      include_in_app_purchases: false
    )
  end

  # =========================================================================
  # 1. CODE SIGNING & CERTIFICATES (using shared sync_dist_certs)
  # =========================================================================
  desc "Sync App Store distribution certificates and provisioning profiles"
  lane :sync_certs do |options|
    readonly = options.fetch(:readonly, is_ci)
    sync_dist_certs(readonly: readonly)
  end

  # =========================================================================
  # 2. BUILD
  # =========================================================================

  desc "Build and archive production .ipa"
  lane :build_app_store do |options|
    app_id = CONFIG["app_identifier"] || "org.curv.palmapp"
    output_dir = options[:output_directory] || "./build"
    FileUtils.mkdir_p(output_dir)

    UI.message("🔨 Building PalmReader for App Store...")

    build_app(
      project: "PalmScanner.xcodeproj",
      scheme: "PalmScanner",
      configuration: "Release",
      export_method: "app-store",
      output_directory: output_dir,
      output_name: "PalmReader.ipa",
      clean: true,
      include_symbols: true,
      include_bitcode: false
    )

    ipa = File.join(output_dir, "PalmReader.ipa")
    UI.success("✅ IPA built successfully at: #{ipa}")
    ipa
  end

  # =========================================================================
  # 3. TESTFLIGHT (BETA) & APP STORE RELEASE
  # =========================================================================

  desc "Build and deploy to TestFlight"
  lane :beta do |options|
    validate_metadata
    sync_certs(readonly: true)

    # Auto-increment build number
    increment_build_number(
      build_number: options[:build_number] || (is_ci ? ENV["BUILD_NUMBER"] : nil)
    )

    ipa = build_app_store

    upload_to_testflight(
      app_identifier: CONFIG["app_identifier"] || "org.curv.palmapp",
      ipa: ipa,
      skip_waiting_for_build_processing: true,
      distribute_external: options.fetch(:distribute_external, false),
      changelog: options[:changelog] || "PalmReader beta build with AI crease detection and Samudrika Shastra reading."
    )
    UI.success("🚀 Uploaded to TestFlight!")
  end

  # =========================================================================
  # 4. METADATA & SCREENSHOT SYNC (DELIVER)
  # =========================================================================

  desc "Upload metadata only to App Store Connect"
  lane :update_metadata do |options|
    validate_metadata
    app_id = CONFIG["app_identifier"] || "org.curv.palmapp"

    meta_path = File.expand_path("metadata", __dir__)
    review_dir = File.join(meta_path, "review_information")
    review_backup = nil

    # Deliver safety: park review_information if first version lacks review detail
    park = options.fetch(:park_review_information, ENV.fetch("PARK_REVIEW_INFORMATION", "0") == "1")
    if park && Dir.exist?(review_dir)
      begin
        review_backup = "#{review_dir}.pending"
        FileUtils.rm_rf(review_backup)
        FileUtils.mv(review_dir, review_backup)
        UI.important("⚠️ Parked review_information for initial deliver")
      rescue StandardError => e
        UI.important("Could not park review_information: #{e.message}")
        review_backup = nil
      end
    end

    begin
      deliver(
        app_identifier: app_id,
        metadata_path: meta_path,
        skip_screenshots: true,
        skip_metadata: false,
        skip_app_version_update: true,
        force: true,
        ignore_language_directory_validation: true,
        run_precheck_before_submit: false
      )
    ensure
      if review_backup && Dir.exist?(review_backup) && !Dir.exist?(review_dir)
        FileUtils.mv(review_backup, review_dir)
        UI.message("Restored review_information/")
      end
    end
    UI.success("✅ App Store Connect metadata synchronized!")
  end

  desc "Upload screenshots only to App Store Connect"
  lane :upload_screenshots do |options|
    app_id = CONFIG["app_identifier"] || "org.curv.palmapp"
    sc_path = File.expand_path("screenshots", __dir__)

    deliver(
      app_identifier: app_id,
      screenshots_path: sc_path,
      skip_screenshots: false,
      skip_metadata: true,
      skip_app_version_update: true,
      force: true,
      ignore_language_directory_validation: true,
      run_precheck_before_submit: false
    )
    UI.success("✅ App Store Connect screenshots uploaded!")
  end

  desc "Synchronize full store listing (metadata + screenshots)"
  lane :sync_store_listing do |options|
    update_metadata(options)
    upload_screenshots(options)
    UI.success("🎉 Complete App Store listing synchronized!")
  end

  desc "Submit app for App Store review"
  lane :submit_app_store do |options|
    app_id = CONFIG["app_identifier"] || "org.curv.palmapp"

    deliver(
      app_identifier: app_id,
      submit_for_review: true,
      automatic_release: false,
      skip_screenshots: true,
      skip_metadata: true,
      submission_information: {
        add_id_info_uses_idfa: false
      },
      run_precheck_before_submit: false
    )
    UI.success("📬 App submitted for App Store review!")
  end

  # =========================================================================
  # 5. COMPLETE RELEASE PIPELINES
  # =========================================================================

  desc "Complete TestFlight + App Store release pipeline"
  lane :production_release do
    # 1. Build and upload to TestFlight first
    beta

    # 2. Validate app locally
    validate_app_local

    # 3. Update metadata and screenshots
    update_metadata
    upload_screenshots

    # 4. Submit for review
    submit_app_store
  end

  desc "Complete release process: metadata + screenshots + submit"
  lane :release do
    update_metadata
    upload_screenshots
    submit_app_store
  end

  desc "Create app icons from source image"
  lane :create_icons do
    appicon(
      appicon_image_file: './assets/icon.png',
      appicon_devices: [:iphone, :ipad, :ios_marketing],
      appicon_path: './ios/PalmScanner/Images.xcassets/AppIcon.appiconset'
    )
  end

  desc "Update provisioning profiles"
  lane :update_profiles do
    match_with_clone_retry({
      type: 'appstore',
      app_identifier: CONFIG["app_identifier"] || "org.curv.palmapp",
      force: true
    })
  end

  desc "Create a new app version in App Store Connect"
  lane :create_version do
    version_number = ask("New version number: ")

    deliver(
      app_identifier: CONFIG["app_identifier"] || "org.curv.palmapp",
      app_version: version_number,
      skip_screenshots: true,
      skip_metadata: true,
      skip_app_version_update: false,
      force: true
    )
  end

  desc "Validate all metadata and screenshots"
  lane :validate_all do
    validate_metadata
    verify_screenshots
  end

  desc "Run tests before release"
  lane :test do
    run_tests(
      scheme: "PalmScanner",
      project: "PalmScanner.xcodeproj",
      devices: ["iPhone 16 Pro"],
      clean: true
    )
  end

  desc "Check app size and performance"
  lane :analyze_app do
    app_store_build_number(
      live: false,
      app_identifier: CONFIG["app_identifier"] || "org.curv.palmapp"
    )
    ensure_no_debug_code(path: './PalmScanner.xcodeproj')
  end

  desc "Generate and upload dSYMs for crash reporting"
  lane :upload_dsyms do
    upload_symbols_to_crashlytics(
      dsym_path: './build/PalmReader.app.dSYM.zip',
      gsp_path: ENV.fetch("GOOGLE_SERVICES_PLIST_PATH", "./ios/GoogleService-Info.plist")
    )
  end

  # =========================================================================
  # 7. BUILD NUMBER MANAGEMENT
  # =========================================================================

  desc "Increment build number using git commit count"
  lane :bump_build do
    build_number = `git rev-list --count HEAD`.strip.to_i
    increment_build_number(build_number: build_number)
    UI.success("✅ Build number set to #{build_number}")
  end
end