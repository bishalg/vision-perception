{
  "$defs": {
    "AttentionFlag": {
      "enum": [
        "green",
        "yellow",
        "red"
      ],
      "type": "string"
    },
    "CaptureSource": {
      "enum": [
        "truedepth",
        "simulated",
        "synthetic"
      ],
      "type": "string"
    },
    "DwellUnits": {
      "description": "Units of the `dwell_*` columns. Ratios of valid clip samples, never seconds (CON-13).",
      "enum": [
        "ratio"
      ],
      "type": "string"
    },
    "ExpectationStatus": {
      "enum": [
        "onTarget",
        "monitor",
        "atypical"
      ],
      "type": "string"
    },
    "GazeQualityVerdict": {
      "enum": [
        "optimal",
        "acceptable",
        "degraded",
        "rejected"
      ],
      "type": "string"
    },
    "GazeSessionRecord": {
      "additionalProperties": true,
      "description": "The full on-device record (`GazeSessionRecord.swift`), carried as `rawPayload`.\n\nDates are RFC 3339 UTC strings with milliseconds (`2026-10-26T07:33:20.000Z`), as\n`SessionPayloadCoding` writes them. Keys this type does not know (for example a future\n`bundleVersion` or `normCollection`) are kept in [`GazeSessionRecord::extra`] and written\nback unchanged, so `sessions.summary` stores the record without loss.",
      "properties": {
        "calibratedDistanceCm": {
          "type": "number"
        },
        "captureSource": {
          "$ref": "#/$defs/CaptureSource"
        },
        "durationSec": {
          "type": "number"
        },
        "endedAt": {
          "format": "date-time",
          "type": "string"
        },
        "eyeDwellRatio": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "firstEyeLatencyMs": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "flatAffectScore": {
          "type": "number"
        },
        "id": {
          "type": "string"
        },
        "legacyProvenance": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "mouthDwellRatio": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "participantId": {
          "description": "Pseudonymous participant token, never a name (CNS-7).",
          "type": "string"
        },
        "perVideo": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/PerVideoScoreReport"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        },
        "perVideoComposite": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "qualityVerdict": {
          "$ref": "#/$defs/GazeQualityVerdict"
        },
        "schemaVersion": {
          "description": "Record form (`\"v1.6\"`); the wire form drops the `v`.",
          "type": "string"
        },
        "sessionId": {
          "type": "string"
        },
        "smileReactivityIndex": {
          "type": "number"
        },
        "socialPreferenceScore": {
          "type": "number"
        },
        "socialSmileIntensity": {
          "type": "number"
        },
        "startedAt": {
          "format": "date-time",
          "type": "string"
        },
        "surpriseScoreMean": {
          "type": "number"
        },
        "validFrameRatio": {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        "zeroRawVideoEnforced": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "sessionId",
        "participantId",
        "captureSource",
        "startedAt",
        "endedAt",
        "durationSec",
        "socialPreferenceScore",
        "validFrameRatio",
        "calibratedDistanceCm",
        "qualityVerdict",
        "socialSmileIntensity",
        "smileReactivityIndex",
        "flatAffectScore",
        "surpriseScoreMean",
        "schemaVersion",
        "zeroRawVideoEnforced"
      ],
      "type": "object"
    },
    "NormativeDirection": {
      "enum": [
        "higherBetter",
        "lowerBetter",
        "band"
      ],
      "type": "string"
    },
    "PerVideoScoreReport": {
      "properties": {
        "category": {
          "type": "string"
        },
        "hasBaseline": {
          "type": "boolean"
        },
        "lowConfidence": {
          "type": "boolean"
        },
        "rows": {
          "items": {
            "$ref": "#/$defs/PerVideoScoreRow"
          },
          "type": "array"
        },
        "stimulusId": {
          "type": "string"
        },
        "subscore": {
          "type": "number"
        },
        "title": {
          "type": "string"
        },
        "validSampleRatio": {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        "weight": {
          "type": "number"
        }
      },
      "required": [
        "stimulusId",
        "title",
        "category",
        "rows",
        "subscore",
        "validSampleRatio",
        "lowConfidence",
        "hasBaseline",
        "weight"
      ],
      "type": "object"
    },
    "PerVideoScoreRow": {
      "properties": {
        "acceptableHigh": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "acceptableLow": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "biomarker": {
          "type": "string"
        },
        "citation": {
          "type": "string"
        },
        "direction": {
          "$ref": "#/$defs/NormativeDirection"
        },
        "expected": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "imputed": {
          "type": "boolean"
        },
        "metricKey": {
          "type": "string"
        },
        "observed": {
          "type": "number"
        },
        "score": {
          "type": "number"
        },
        "segmentDescription": {
          "type": "string"
        },
        "segmentId": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ExpectationStatus"
        },
        "targetAOI": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "segmentId",
        "segmentDescription",
        "biomarker",
        "metricKey",
        "direction",
        "observed",
        "status",
        "score",
        "imputed",
        "citation",
        "source"
      ],
      "type": "object"
    },
    "SessionPerVideoDetails": {
      "description": "`SessionPerVideoRow.Details` (camelCase).",
      "properties": {
        "category": {
          "type": "string"
        },
        "dwellUnits": {
          "$ref": "#/$defs/DwellUnits"
        },
        "hasBaseline": {
          "type": "boolean"
        },
        "lowConfidence": {
          "type": "boolean"
        },
        "rows": {
          "items": {
            "$ref": "#/$defs/PerVideoScoreRow"
          },
          "type": "array"
        },
        "subscore": {
          "type": "number"
        },
        "title": {
          "type": "string"
        },
        "validSampleRatio": {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        }
      },
      "required": [
        "title",
        "category",
        "subscore",
        "validSampleRatio",
        "lowConfidence",
        "hasBaseline",
        "dwellUnits",
        "rows"
      ],
      "type": "object"
    },
    "SessionPerVideoScore": {
      "description": "One flattened per-clip row (`SessionPerVideoRow` in Swift; schema name\n`SessionPerVideoScore`, which the Swift schema test looks up by name). snake_case.\n\nA metric the clip did not measure, or measured only by imputation, is an absent key.",
      "properties": {
        "clip_id": {
          "type": "string"
        },
        "details": {
          "$ref": "#/$defs/SessionPerVideoDetails"
        },
        "dwell_eye": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "dwell_geometric": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "dwell_mouth": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "dwell_social": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "fixation_count": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "mean_fixation_ms": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "order": {
          "description": "1-based play order.",
          "type": "integer"
        },
        "orienting_latency_ms": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Measured first-entry latency; an imputed latency is not sent."
        },
        "score": {
          "type": "number"
        },
        "status": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExpectationStatus"
            },
            {
              "type": "null"
            }
          ],
          "description": "Worst row status of the clip; absent when the clip has no scored rows."
        },
        "weight": {
          "type": "number"
        }
      },
      "required": [
        "clip_id",
        "order",
        "score",
        "weight",
        "details"
      ],
      "type": "object"
    }
  },
  "$id": "https://schemas.curv.org/asd/session-v1.6.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Curv Pediatric ASD Gaze Session Ingestion Schema (v1.6)",
  "properties": {
    "attentionFlag": {
      "anyOf": [
        {
          "$ref": "#/$defs/AttentionFlag"
        },
        {
          "type": "null"
        }
      ],
      "description": "Explicit `null` when the device did not compute a flag; the server then derives it\n(CON-15). `None` = key absent, `Some(None)` = `null`."
    },
    "battery": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "Catalog protocol id (`express_30s`, CON-16) or explicit `null` when unknown."
    },
    "calibratedDistanceCm": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "captureSource": {
      "$ref": "#/$defs/CaptureSource"
    },
    "durationSec": {
      "type": "number"
    },
    "eyeDwellRatio": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "firstEyeLatencyMs": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "mouthDwellRatio": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "participantToken": {
      "description": "Pseudonymous token (CNS-7), never a name.",
      "type": "string"
    },
    "perVideo": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/SessionPerVideoScore"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ]
    },
    "qualityVerdict": {
      "$ref": "#/$defs/GazeQualityVerdict"
    },
    "rawPayload": {
      "$ref": "#/$defs/GazeSessionRecord"
    },
    "schemaVersion": {
      "description": "Wire form (`\"1.6\"`), equal to the `X-Schema-Version` header (CON-21).",
      "type": "string"
    },
    "sessionId": {
      "type": "string"
    },
    "socialPreferenceScore": {
      "type": "number"
    },
    "validRatio": {
      "maximum": 1.0,
      "minimum": 0.0,
      "type": "number"
    }
  },
  "required": [
    "sessionId",
    "participantToken",
    "captureSource",
    "durationSec",
    "validRatio",
    "socialPreferenceScore",
    "qualityVerdict",
    "schemaVersion",
    "rawPayload"
  ],
  "title": "SessionIngestRequest",
  "type": "object"
}
