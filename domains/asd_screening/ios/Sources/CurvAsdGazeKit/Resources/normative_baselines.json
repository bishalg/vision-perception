          "startSec": 0.0,
          "endSec": 8.0,
          "expectations": [
            {
              "biomarker": "eye_dwell_ratio",
              "direction": "band",
              "targetAOI": null,
              "byAge": {
                "default": { "expected": 0.35, "acceptableLow": 0.25, "acceptableHigh": 0.45 }
              },
              "citation": "Eye-region share of face dwell; typical 0.25-0.45 (Curv clinical baseline; JBI 2022 feature set).",
              "source": "literature"
