                "default": { "expected": 420.0, "acceptableHigh": 600.0 },
                "12-17": { "expected": 500.0, "acceptableHigh": 750.0 }
              },
              "citation": "Typical first-eye latency <420ms, prolonged >600ms (Curv clinical baseline; Jones et al. JAMA 2023 time-to-first-fixation). Younger bracket interpolated.",
