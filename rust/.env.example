# owner: WP-B.1
# asd-backend configuration. Copy to rust/.env (git-ignored) and adjust; compose reads it
# when present. Every variable is optional except DATABASE_URL.

# ---- server
# ASD_BIND_ADDR=0.0.0.0:8000
# Whole-request timeout in seconds.
# ASD_REQUEST_TIMEOUT_SECS=30
# tracing filter (RUST_LOG syntax). Logs are JSON lines with PHI redaction (OBS-1).
RUST_LOG=info,sqlx=warn,tower_http=info
# The console origin allowed by CORS (exactly one origin, never "*"). Unset = no CORS.
# ASD_CONSOLE_ORIGIN=http://localhost:3000

# ---- database (Postgres 16)
# Inside compose the host is `postgres`; from the host machine use localhost.
DATABASE_URL=postgres://asd:asd@localhost:5432/asd
POSTGRES_PASSWORD=asd
# ASD_DB_MAX_CONNECTIONS=10
# ASD_DB_ACQUIRE_TIMEOUT_MS=5000

# ---- blobs (frames.jsonl.enc, report.pdf)
# presigned = absolute S3 PUT URLs (AWS); proxy = relative /v1/sessions/{id}/blobs/*
# under the device bearer. iOS rejects IP/localhost upload hosts, so the demo uses proxy.
BLOB_MODE=proxy
# s3 (AWS or MinIO) | memory (tests / quick local runs; lost on restart)
ASD_BLOB_BACKEND=s3
S3_BUCKET=curv-asd-sessions
S3_REGION=us-east-1
# MinIO: endpoint + path-style. Leave both unset for AWS S3.
S3_ENDPOINT_URL=http://localhost:9000
S3_FORCE_PATH_STYLE=true
# Credentials use the standard AWS chain. For MinIO these are its root user/password.
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin-change-me

# ---- auth (WP-B.2)
# Ed25519 key for console access tokens (EdDSA JWT, 15 min): PKCS#8 PEM from
# `asd-cli bundle keygen`, or a base64 32-byte seed. Required for login; must differ from
# the bundle signing key. Never commit a real key; put it in rust/.env or the secret store.
# ASD_JWT_SIGNING_KEY=
# Behind Cloudflare Tunnel or an ALB: take the client IP from CF-Connecting-IP / the last
# X-Forwarded-For hop for rate limits and audit rows. Leave off when clients connect directly.
# ASD_TRUST_PROXY_HEADERS=false

# ---- config bundles (WP-B.4, CFG-1)
# Ed25519 key that signs config bundles (CON-6): PKCS#8 PEM from `asd-cli bundle keygen`, or
# a base64 32-byte seed. Must differ from ASD_JWT_SIGNING_KEY (the server refuses equal keys).
# Unset = POST /v1/config/bundles answers 503; already published bundles are still served.
# Apps embed the matching public key (`asd-cli bundle keygen` prints it).
# ASD_BUNDLE_SIGNING_KEY=

# ---- clinical data encryption (WP-C.9, KEY-2)
# Key-encryption key for clinical content (notes, impressions, letters, MRNs, review notes):
# standard base64 of 32 random bytes, e.g. `openssl rand -base64 32`. It wraps one data key
# per org (table org_data_keys); clinical text is AES-256-GCM encrypted in the API, never in
# SQL. Unset = clinical endpoints answer 503 clinical-crypto-unavailable and review notes
# are refused; everything else runs. LOSING THIS KEY LOSES ALL CLINICAL TEXT: keep it in the
# secret store (Secrets Manager/KMS in WP-B.7) with a backup, never in git. After setting it
# on an existing deployment, run once: `asd-backend admin encrypt-review-notes`.
# ASD_DATA_KEK=

# ---- contract switches
# Accept captureSource "synthetic" (seed data, CON-13). Never true in production.
ASD_ALLOW_SYNTHETIC=false

# ---- tests
# Backend integration tests create one database per test on this server and skip
# without it (set ASD_REQUIRE_ALL=1 to fail instead, as CI does):
# DATABASE_URL=postgres://asd:asd@localhost:5432/asd_test SQLX_OFFLINE=true \
#   cargo test --manifest-path rust/Cargo.toml -p asd-backend
