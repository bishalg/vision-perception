  "query": "SELECT session_id, participant_pseudonym, age_months, age_band, split, label,\n                  erased_at IS NOT NULL AS \"erased!\"\n           FROM dataset_members\n           WHERE dataset_id = $1\n             AND ($2::text IS NULL OR split = $2)\n             AND ($3::text IS NULL OR session_id > $3)\n           ORDER BY session_id\n           LIMIT $4",
