  "query": "SELECT id, email, role, status, last_login_at, created_at\n         FROM users\n         WHERE org_id = $1\n           AND ($2::timestamptz IS NULL OR (created_at, id) < ($2, $3))\n         ORDER BY created_at DESC, id DESC\n         LIMIT $4",
