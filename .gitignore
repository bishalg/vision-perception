cdk.out/
.venv-cdk/

# Gaze app BDD/Maestro output
apps/ios_asd_gaze_app/maestro/screenshots/
apps/ios_asd_gaze_app/build-sim/

# ------------------------------------------------------------------------------
# Rust workspace (rust/): build output ignored; offline sqlx data and lockfile committed
# ------------------------------------------------------------------------------
rust/target
**/*.xcframework
build/asd/
!rust/.sqlx/
!rust/.sqlx/**
!rust/.env.example
!rust/Cargo.lock
# WP-B.8 golden report PDFs (trap 1: *.pdf is ignored above)
!rust/crates/asd-report/tests/golden/*.pdf

# console source dir named lib/ is real source, not build output
!apps/curv_console/src/lib/
