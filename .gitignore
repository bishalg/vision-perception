apps/ios_asd_gaze_app/fastlane/report.xml
apps/ios_asd_gaze_app/fastlane/Preview.html
apps/ios_asd_gaze_app/fastlane/screenshots/**/*.png
apps/ios_asd_gaze_app/fastlane/test_output
