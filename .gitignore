# ==============================================================================
# Vision-Perception Monorepo .gitignore
# C++, CMake, Android NDK, Apple/macOS, IDEs, and Runtime Artifacts
# ==============================================================================

# ------------------------------------------------------------------------------
# Compiled Binaries & Libraries
# ------------------------------------------------------------------------------
*.o
*.obj
*.so
*.so.*
*.dylib
*.dll
*.lib
*.a
*.exe
*.out
*.app
*.bin


# Raw LLVM coverage profiles and root-dir test artifacts
*.profraw
*.pdf
/evidence.json
/canonical_palm.png
/overlay_palm.png
/gemini_prompt.json
/output_overlay.png
/synthetic/
/eval_gate_tmp/
/output/
data/fixtures/cctv/http_cache/
data/samples/**/*_Bishal*
data/samples/**/*_bishal*
data/samples/**/01_left_bishal*
data/samples/**/02_right_bishal*
data/samples/**/*_full_overlay.png

# ------------------------------------------------------------------------------
# CMake & Build Directories
# ------------------------------------------------------------------------------
build/
build-*/
cmake-build-*/
_build/
bin/
!rust/crates/*/src/bin/
lib/
# `lib/` targets build-output dirs, but real sources live under tools/lib/.
!tools/lib/
!tools/lib/**
.cache/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile
!services/**/Makefile
*.ninja
.ninja_*
compile_commands.json
CTestTestfile.cmake
Testing/
install_manifest.txt
*.cmake.in.bak
CPackConfig.cmake
CPackSourceConfig.cmake
_CPack_Packages/

# Conan / vcpkg / Dependency Managers
vcpkg_installed/
conan.lock
conanbuildinfo.*
conaninfo.txt

# ------------------------------------------------------------------------------
# Apple / macOS Artifacts
# ------------------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
*.dSYM/
*.bundle
DerivedData/
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3
xcuserdata/
*.xccheckout
*.moved-builder
profile
*.ipa

# ------------------------------------------------------------------------------
# Android NDK / Android Studio
# ------------------------------------------------------------------------------
.cxx/
local.properties
.gradle/
captures/
obj/
*.apk
*.aar
*.ap_
*.dex
ndk-build/

# ------------------------------------------------------------------------------
# IDEs & Editor Configuration
# ------------------------------------------------------------------------------
# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# CLion / JetBrains
.idea/

# ZCode agent workspace artifacts
.zcode/

# ------------------------------------------------------------------------------
# Vendored iOS toolchain artifacts (built on demand by scripts/build_opencv_ios.sh)
third_party/ios/opencv2.xcframework/
third_party/ios/opencv-src-*/
third_party/ios/opencv-build-*/

# SPM build artifacts
adapters/apple/.build/
apps/mobile_overlay/ios/.build/
.build/

# Visual Studio
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates

# Vim / Emacs
*~
*.swp
*.swo
.#*
\#*#

# ------------------------------------------------------------------------------
# Debugging, Profiling, & Sanitizers
# ------------------------------------------------------------------------------
*.gcov
*.gcda
*.gcno
gmon.out
callgrind.out.*
vgcore.*
sanitizer.log.*

# ------------------------------------------------------------------------------
# Python & Tooling Environment (evaluation / scripts)
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ------------------------------------------------------------------------------
# Presentation recordings / large slide assets (keep locally)
# ------------------------------------------------------------------------------
docs/presentation/assets/
*.key
*.pptx

# ------------------------------------------------------------------------------
# Node / web apps
# ------------------------------------------------------------------------------
node_modules/
apps/**/dist/
apps/**/.vite/

# ------------------------------------------------------------------------------
# Large Datasets, Video Feeds, and Binary Model Weights
# ------------------------------------------------------------------------------
*.mp4
*.avi
*.mov
*.mkv
*.m4v
# Keep short offline demo/test clips under fixtures (Phase 2+).
!data/fixtures/**/*.avi
!data/fixtures/**/*.mp4
*.bag
*.h5
*.tflite
*.onnx
*.weights
*.pt
*.pth
*.tar.gz
*.zip
*.7z

# Environment files and credentials
.env
.env.*
*.env

# Dataset directories (ignore flood binaries, permit metadata)
data/flood_nepal_2026/*
!data/flood_nepal_2026/metadata.json

# Flood-label bootstrap (Roboflow JPEGs + work dirs — never commit binaries)
data/flood_labels/raw/
data/flood_labels/_download/
data/flood_labels/**/*.jpg
data/flood_labels/**/*.jpeg
data/flood_labels/**/*.png
!data/flood_labels/README.md
!data/flood_labels/manifest.json
!data/flood_labels/**/*_USER_CORRECTED*.json

# Palm-label bootstrap (Roboflow JPEGs + work dirs — never commit binaries)
data/palm_labels/raw/
data/palm_labels/_download/
data/palm_labels/**/*.jpg
data/palm_labels/**/*.jpeg
data/palm_labels/**/*.png
!data/palm_labels/README.md
!data/palm_labels/manifest.json
!data/palm_labels/**/*_USER_CORRECTED*.json

# Flood-label bootstrap (Roboflow JPEGs + work dirs — never commit binaries)
data/flood_labels/raw/
data/flood_labels/_download/
data/flood_labels/**/*.jpg
data/flood_labels/**/*.jpeg
data/flood_labels/**/*.png
!data/flood_labels/README.md
!data/flood_labels/manifest.json
!data/flood_labels/**/*_USER_CORRECTED*.json

# Exceptions: keep small golden fixture data or test config files explicitly
!data/samples/
!data/synthetic/
!data/annotations/
!data/palm_labels/
!data/flood_labels/
!.gitkeep


# Root menu runner has zero deps — ignore its empty lockfile (cesium keeps its own)
pnpm-lock.yaml

